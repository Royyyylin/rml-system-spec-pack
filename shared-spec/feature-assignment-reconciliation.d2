# AI-DIAGRAM: required
# primary_message: App must show Central assignment truth and firmware runtime attach side by side until they converge.
# reader: newcomer, reviewer
# template_id: ctx-owner-merge-state
# diagram_type: d2-context
# layout: left-to-right
# max_nodes: 5
# max_groups: 3
# keep: central truth, runtime observation, app reconciliation states
# avoid: full failover algorithm, version fields, every edge case

direction: right

central: "Central\nassignment truth\nactive Gateway"
firmware: "Firmware\nruntime attach\nobserved Gateway"
app: "App\nshow both sources\nnever collapse mismatch"
states: "Badge states\nconfirmed\npending\nconflict\ncentral_only\norphaned"
rule: "Rule\nCentral owns assignment\nFirmware owns observation"

central -> app: "authoritative"
firmware -> app: "runtime"
app -> states: "derive state"
rule -> app: "boundary"
