# AI-DIAGRAM: required
# primary_message: App connects to one BLE peer at a time; the peer type determines the data path and what counts as first-hand observation.
# reader: newcomer
# template_id: ctx-topology-path
# diagram_type: d2-context
# layout: left-to-right
# max_nodes: 6
# max_groups: 2
# keep: App single-session, CC bridge relay vs GW/ED direct, first-hand vs relayed distinction
# avoid: telemetry details, state machines, command lifecycle, packet formats

direction: right

style: {
  font-size: 70
}

app: "App 手機端\n同時只連一台 peer"

# --- Central-side path ---
central_path: "Central 側路徑" {
  style.fill: "#e8f4fd"
  cc: "CC bridge 橋接器\n僅轉發"
  central: "Central 中央系統"
  cc -> central: "轉發"
}

# --- Firmware-side path ---
firmware_path: "Firmware 側路徑" {
  style.fill: "#fef3e2"
  gw: "GW 閘道器\n第一手觀測"
  ed: "ED 終端裝置\n第一手觀測"
}

# --- App connects to one or the other ---
app -> central_path.cc: "轉發視圖 relayed"
app -> firmware_path.gw: "第一手 first-hand"
app -> firmware_path.ed: "第一手 first-hand"

# --- Key distinction ---
rule: "連線規則\n1. CC bridge = Central 側\n2. GW/ED = Firmware 側\n3. 經 CC 看到的名稱是轉發\n4. 不可同時走兩條路徑" {
  style.fill: "#fff8e1"
  style.stroke: "#c9a227"
}
