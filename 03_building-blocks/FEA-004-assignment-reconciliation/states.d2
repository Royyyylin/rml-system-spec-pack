# AI-DIAGRAM: required
# primary_message: Central assignment and firmware runtime attach are compared into 5 reconciliation states with explicit transitions.
# reader: newcomer
# template_id: state-single-fsm
# diagram_type: d2-state
# layout: top-to-bottom
# max_nodes: 5
# max_groups: 1
# keep: 5 canonical state names, transition triggers, pending_reconciliation full name
# avoid: session scope gate (separate diagram), failover algorithm, UI layout details

direction: down

style: {
  font-size: 70
}

# ===== 正常態 =====
confirmed: "confirmed 已確認\nCentral = runtime\n指向同一台 Gateway" {
  style.fill: "#d4edda"
}

# ===== 過渡態 =====
pending_reconciliation: "pending_reconciliation\n待調和\nruntime 先切換" {
  style.fill: "#fff3cd"
}

central_only: "central_only\n僅 Central 可見\nCentral 先變更" {
  style.fill: "#cce5ff"
}

conflict: "conflict 衝突\n雙方皆活躍\n但指向不同台" {
  style.fill: "#f8d7da"
}

# ===== 異常態 =====
orphaned: "orphaned 孤立\n無分配、無連接\n異常狀態" {
  style.fill: "#e2e3e5"
}

# ===== 轉移 =====
confirmed -> pending_reconciliation: "runtime 先切換"
confirmed -> central_only: "Central 先變更"
confirmed -> orphaned: "兩邊皆無"

pending_reconciliation -> confirmed: "雙方匯合"
pending_reconciliation -> conflict: "雙方不同"

central_only -> confirmed: "runtime 跟上"

conflict -> confirmed: "雙方匯合"

orphaned -> confirmed: "恢復分配"
orphaned -> pending_reconciliation: "runtime 先出現"

# ===== 規則 =====
rule: "規則\n1. 待調和 = 正常 failover 延遲\n2. 衝突需雙方都可比較\n3. Central 不可達 → 無法比較\n4. 孤立 = 異常，非閒置" {
  style.fill: "#fff8e1"
  style.stroke: "#c9a227"
}
